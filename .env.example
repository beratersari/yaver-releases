# Copy to .env next to this folder and edit. Do not commit .env.

# Where published zips and the login secret are stored.
YAVER_RELEASE_DATA=data

# Listen on the LAN. Use 127.0.0.1 to keep it on this PC.
YAVER_RELEASE_HOST=0.0.0.0
YAVER_RELEASE_PORT=8090

# Admin upload login. Both are required. There is no default password.
YAVER_RELEASE_ADMIN_USER=admin
YAVER_RELEASE_ADMIN_PASSWORD=choose-a-long-password

# Optional. When empty, the server creates data/secret.key on first start.
# YAVER_RELEASE_SECRET=
